# Copier en .env pour le développement local. Ne jamais versionner .env.
NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/caisse
DIRECT_URL=postgresql://postgres:postgres@localhost:5432/caisse
CORS_ORIGINS=http://localhost:5173
# Secrets : générer avec `openssl rand -base64 48`
JWT_ACCESS_SECRET=dev-local-jwt-secret-0123456789-abcdefghijkl
PDF_LINK_SECRET=dev-local-pdf-secret-0123456789-abcdefghijkl
PUBLIC_API_URL=http://localhost:3000
PUBLIC_WEB_URL=http://localhost:5173
# Facultatif en local : sans clé, les e-mails sont seulement journalisés.
RESEND_API_KEY=
MAIL_FROM=Caisse <onboarding@resend.dev>
