{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "pnpm install --frozen-lockfile",
  "buildCommand": "pnpm --filter @caisse/shared build && pnpm build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/((?!assets/|sw.js|workbox-|manifest.webmanifest|icon.svg).*)",
      "destination": "/index.html"
    }
  ]
}
